prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libavdevice
Description: FFmpeg device handling library
Version: 63.6.100
Requires: 
Requires.private: libavfilter >= 12.9.100, libswscale >= 10.6.100, libavformat >= 63.17.100, libavcodec >= 63.25.101, libswresample >= 7.7.100, libavutil >= 61.20.100
Conflicts:
Libs: -L${libdir}  -lavdevice 
Cflags: -I${includedir}
